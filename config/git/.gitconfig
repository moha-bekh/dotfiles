[user]
	name = moha-bekh
	email = moha.bekh.pro@gmail.com
[alias]
	st = status
  lg = log --graph --pretty=format:'%Cblue%h%Creset %ad %s %C(blue)%d%Creset %C(bold magenta)<%an>%Creset' --date=short
  ck = checkout
  br = branch
	cm = commit -m
  cam = commit -am
  saf = diff-tree --no-commit-id --name-only -r
[interactive]
	diffFilter = delta --color-only
[diff]
	colorMode = default
[init]
	defaultBranch = main
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[diff "lfstext"]
	textconv = cat
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
