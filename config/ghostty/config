theme = TokyoNight Night
# Second family is the fallback for anything the first doesn't have (emojis)
font-family = "JetBrainsMono Nerd Font"
font-family = "Noto Color Emoji"
font-size = 12
mouse-hide-while-typing = true
window-decoration = true
macos-titlebar-style = hidden
# keybind = global:cmd+/=toggle_quick_terminal
macos-option-as-alt = true
# Send explicit tmux keys, overriding Ghostty shortcuts (notably Ctrl+Shift+J).
keybind = alt+shift+h=esc:H
keybind = alt+shift+l=esc:L
keybind = ctrl+shift+h=csi:104;6u
keybind = ctrl+shift+j=csi:106;6u
keybind = ctrl+shift+k=csi:107;6u
keybind = ctrl+shift+l=csi:108;6u
background-opacity = 0.9
